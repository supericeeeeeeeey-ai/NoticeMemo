<Window x:Class="NoticeMemo.App.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="导入通知 · NoticeMemo" Width="880" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{StaticResource PaperBrush}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="18" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="5">
                        <TextBlock Text="+" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="导入通知" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <TextBlock Text=" / 先确认，再收进备忘录" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="×" Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="把群通知变成一张卡片" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="粘贴通知原文，NoticeMemo 会自动识别截止时间、地点、分类和链接。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="来源群聊" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="SourceGroupBox"
                                 Text="{Binding SourceGroup, UpdateSourceTrigger=PropertyChanged, FallbackValue=学院通知群}"
                                 Style="{StaticResource InputTextBox}" Height="50" Padding="12,9"
                                 VerticalContentAlignment="Center" Margin="0,0,0,14" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="通知原文" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Button Content="从剪贴板粘贴" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                    Padding="8,4" Click="Paste_Click" />
                        </DockPanel>
                        <TextBox Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 MinHeight="300" />
                        <TextBlock Text="提示：带“截止/前/报名/提交”等词的通知，日期识别会更准确。"
                                   Style="{StaticResource SmallLabel}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="18" Margin="18,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="解析预览" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="25" />
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14" />
                                <TextBlock Text="截止时间" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding PreviewDue}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="分类" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding PreviewCategory}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="地点" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding PreviewLocation}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="优先级" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding PreviewPriority}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="标签" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding PreviewTags}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="11" Margin="0,20,0,0">
                                    <TextBlock Text="识别结果可以修改，保存后会进入“待整理”，不会自动发到群里。"
                                               Foreground="{StaticResource AccentDarkBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="17" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="数据只保存在本机" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                        <Button Content="保存到待整理" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                IsEnabled="{Binding CanSave}" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
