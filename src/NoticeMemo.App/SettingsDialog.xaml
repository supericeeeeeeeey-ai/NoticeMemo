<Window x:Class="NoticeMemo.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="后台捕获设置 · NoticeMemo" Width="660" Height="940" MinWidth="600" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{StaticResource PaperBrush}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="18" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="5">
                        <TextBlock Text="N" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="设置" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <TextBlock Text=" / 全天候捕获" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="×" Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,24,30,10">
                    <TextBlock Text="让通知自己走进来" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="自动读取 QQ 的 Windows 系统通知，同时保留剪贴板导入作为兜底；只收藏看起来像学院通知的内容。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20" />

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="捕获方式" Style="{StaticResource SectionLabel}" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding ClipboardMonitoringEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="自动捕获剪贴板通知" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="在 QQ 中复制一条消息后，自动进入识别流程。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,16" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding QqNotificationMonitoringEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="自动读取 QQ 系统通知（实验性）" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="只处理群名包含下方来源群聊的 QQ 通知。需要 QQ 开启 Windows 系统通知；群消息免打扰、通知被清除时可能捕获不到。"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,16" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AutoSaveHighConfidence, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="高置信度通知直接收录" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭后，捕获到的通知会留在托盘提示中，点击后再确认。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="来源与启动" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="通知来源群聊" Style="{StaticResource MetaLabel}" />
                            <Border Height="50" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                                <TextBox Text="{Binding SourceGroup, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource AccentBrush}" FontSize="12.5"
                                         Padding="12,0" VerticalContentAlignment="Center" />
                            </Border>
                            <TextBlock Text="QQ 自动监听会用这段文字匹配通知里的群名，例如“学院通知群”可以匹配“XX学院通知群”。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,-8,0,16" LineHeight="17" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="随 Windows 登录后自动启动" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="写入当前用户的启动项，以 --background 模式运行，不需要管理员权限。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="日程提醒" Style="{StaticResource SectionLabel}" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding RemindersEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="即将截止时提醒我" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="对识别到截止时间且未完成、未删除的备忘录发送 Windows 托盘提醒。程序重启后会补发尚未提醒过的临期事项。"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="默认提醒时间" Style="{StaticResource MetaLabel}" Margin="32,16,0,5" />
                            <ComboBox ItemsSource="{Binding ReminderLeadOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Minutes"
                                      SelectedValue="{Binding ReminderLeadMinutes, Mode=TwoWay}"
                                      IsEnabled="{Binding RemindersEnabled}" Height="42" Margin="32,0,0,0"
                                      Padding="10,0" FontSize="12" BorderBrush="{StaticResource LineBrush}"
                                      Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="托盘与提示" Style="{StaticResource SectionLabel}" />
                            <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="显示托盘气泡提示" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="自动收录、等待确认和日程到期时，在 Windows 右下角给出简短提示。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                                <TextBlock Text="关闭主窗口只会隐藏到托盘，后台捕获仍会继续。要完全退出，请使用托盘菜单中的“退出 NoticeMemo”。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="14" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="边界说明" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                            <TextBlock Text="自动模式只读取 Windows 通知中心里 QQ 已展示的系统通知，并按来源群名过滤；不读取 QQ 聊天数据库、不登录 QQ、不模拟点击，也不使用非官方协议。QQ 关闭系统通知、群消息免打扰或通知已被清除时，仍可能漏消息，此时可复制消息作为兜底。"
                                       Foreground="{StaticResource AccentDarkBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="30,14,30,24">
                <TextBlock Text="设置只保存在本机" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
